# ──────────────────────────────────────────────
# Groq API Key (primary LLM — free tier)
# ──────────────────────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b

# ──────────────────────────────────────────────
# Embedding Configuration
# ──────────────────────────────────────────────
# Sentence Transformers model — produces 384-dim vectors
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Query embedding cache: process-local LRU cache for repeated search queries.
# Set TTL or capacity to 0 to disable retention; values must be non-negative.
EMBEDDING_CACHE_TTL_SECONDS=1800
EMBEDDING_CACHE_MAX_SIZE=1000

# ──────────────────────────────────────────────
# RAG / Chunking Configuration
# ──────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ──────────────────────────────────────────────
# Connection Pool & Query Optimisation
# ──────────────────────────────────────────────
# Max simultaneous Supabase REST connections.
# Keep below your Supabase plan's connection limit (free=60, pro=200+).
DB_POOL_MAX_CONNECTIONS=10

# Seconds to wait for a free pool slot before raising TimeoutError.
DB_POOL_TIMEOUT_SECONDS=30

# pgvector HNSW ef_search — candidate list size at query time.
# 40=dev (fast), 100=prod (balanced), 200=audit (high recall).
HNSW_EF_SEARCH=100


# ──────────────────────────────────────────────
# Device Identity (optional)
# ──────────────────────────────────────────────
CARESYNC_USER_ID=

# ──────────────────────────────────────────────
# Guidelines Sync (scripts/sync_guidelines.py)
# ──────────────────────────────────────────────
GUIDELINES_SOURCE_URL=mock
GUIDELINES_WATCH_TITLES=
SYNC_USER_ID=sync-cron

# ──────────────────────────────────────────────
# Migration & Backup (scripts/)
# ──────────────────────────────────────────────
# Direct PostgreSQL connection string for verify_migration.py
# Found at: Supabase → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:6tbsuAFOgLsGbfqq@db.kqtyqzubyisnetyrgwyx.supabase.co:5432/postgres

# Output directory for backup_db.py (default: ./backups)
BACKUP_DIR=backups
